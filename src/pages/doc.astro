import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ActionLifecycleDiagram from '../components/ActionLifecycleDiagram.astro';
---
<Base
  title="Documentation — Morflow Data Processing Engine"
  description="Comprehensive step-by-step technical guide for the Morflow CLI and the .morf dataflow pipeline syntax."
  path="/doc"
>
  <PageHero
    badge="Documentation"
  >
    Morflow Engine &amp; <em>Syntax Reference</em>
  </PageHero>

  <div class="docs-layout">
    <!-- Sticky Sidebar -->
    <aside class="docs-sidebar" aria-label="Documentation Navigation">
      <div class="docs-nav-group">
        <a href="#cli" class="docs-nav-title">1. CLI Reference</a>
        <ul class="docs-nav-list">
          <li><a href="#cli-installation" class="docs-nav-link">1.1. Installation</a></li>
          <li><a href="#cli-commands" class="docs-nav-link">1.2. Core CLI Commands</a></li>
          <li><a href="#cli-check" class="docs-nav-link">1.3. Pipeline Verification (check)</a></li>
          <li><a href="#cli-prep" class="docs-nav-link">1.4. Offline Prep (prep)</a></li>
          <li><a href="#cli-search-spec" class="docs-nav-link">1.5. Search &amp; Spec</a></li>
          <li><a href="#cli-env" class="docs-nav-link">1.6. Environment Variables</a></li>
        </ul>
      </div>

      <div class="docs-nav-group">
        <a href="#syntax" class="docs-nav-title">2. .morf Syntax Guide</a>
        <ul class="docs-nav-list">
          <li><a href="#syntax-step1-action" class="docs-nav-link">2.1. Anatomy of an Action</a></li>
          <li><a href="#syntax-step2-flow" class="docs-nav-link">2.2. Inputs &amp; Constructing a Flow</a></li>
          <li><a href="#syntax-step3-emit" class="docs-nav-link">2.3. Emitting Output &amp; Intermediate Emission (emit)</a></li>
          <li><a href="#syntax-step4-multiflow" class="docs-nav-link">2.4. Multiple Flows in One File</a></li>
          <li><a href="#syntax-step5-control" class="docs-nav-link">2.5. Advanced Control Flow (Loops &amp; Conditionals)</a></li>
          <li><a href="#syntax-step6-examples" class="docs-nav-link">2.6. Complete End-to-End Examples</a></li>
        </ul>
      </div>

      <div class="docs-nav-group">
        <a href="#types" class="docs-nav-title">3. Data Types and Shape</a>
        <ul class="docs-nav-list">
          <li><a href="#types-overview" class="docs-nav-link">3.1. Type Hierarchy &amp; Architecture</a></li>
          <li><a href="#types-tensor" class="docs-nav-link">3.2. Tensor</a></li>
          <li><a href="#types-image" class="docs-nav-link">3.3. Image</a></li>
          <li><a href="#types-audio" class="docs-nav-link">3.4. Audio</a></li>
          <li><a href="#types-scalar" class="docs-nav-link">3.5. Scalar</a></li>
          <li><a href="#types-bytes" class="docs-nav-link">3.6. Bytes</a></li>
          <li><a href="#types-composite" class="docs-nav-link">3.7. Composite</a></li>
          <li><a href="#types-arguments" class="docs-nav-link">3.8. Configuration Arguments (*Arg)</a></li>
          <li><a href="#types-each" class="docs-nav-link">3.9. Deep Dive: Slicing &amp; Restacking with 'each'</a></li>
          <li><a href="#types-shapechecking" class="docs-nav-link">3.10. Shapes &amp; Shape Checking</a></li>
        </ul>
      </div>

      <div class="docs-nav-group">
        <a href="#exec" class="docs-nav-title">4. Pipeline Execution</a>
        <ul class="docs-nav-list">
          <li><a href="#exec-python" class="docs-nav-link">4.1. Python</a></li>
          <li><a href="#exec-js" class="docs-nav-link">4.2. JavaScript / Node.js</a></li>
          <li><a href="#exec-java" class="docs-nav-link">4.3. Java</a></li>
