---
import Base from '../../layouts/Base.astro';
import CodeCard from '../../components/CodeCard.astro';
import { withBase } from '../../lib/content';
import { useCases, useCasePath } from '../../content/usecases';
import { longDate, useCaseJsonLd, type Faq } from '../../lib/usecase';

const meta = useCases.find((u) => u.slug === 'audio-processing-nodejs')!;
const site = Astro.site ?? new URL('https://morflow.org');

const faq: Faq[] = [
  {
    q: 'Can Morflow read MP3, AAC or M4A files?',
    a: 'No. Morflow reads WAV files and raw PCM samples. Decode other formats to WAV first, for example with ffmpeg, and then run the pipeline. Check that a file starts with a WAV header before you process it, because bytes that are not a WAV file are read as raw PCM samples instead of being rejected.',
  },
  {
    q: 'Which kinds of WAV files work?',
    a: 'WAV files with 8, 16, 24 or 32-bit integer samples, or 32-bit float samples, at any sample rate and with any number of channels. In our tests, 16-bit, 24-bit, 32-bit and float versions of the same recording all gave exactly the same output. The cleaned file is 16-bit WAV unless you ask to_wav for another format.',
  },
  {
    q: 'Does processing a long file block the Node.js event loop?',
    a: 'Not with run() or runArgs(). They process the audio on Morflow\'s own threads and return a Promise. In our test the event loop never paused for more than 77 ms while a 30-minute file was processed. The synchronous runSync() blocks the event loop for the whole run, so keep it for scripts.',
  },
  {
    q: 'Does it work with TypeScript?',
    a: 'Yes. The morflow package includes its own type definitions, so pipeline.run(), runArgs() and the result types are typed with no extra packages.',
  },
  {
    q: 'Do I need an internet connection to process audio?',
    a: 'Only once, to download the audio actions with morflow prep. After that the pipeline runs fully offline, and nothing leaves your machine.',
  },
  {
    q: 'Can I run the same pipeline in Python or in a mobile app?',
    a: 'Yes. The .morf file is plain text, and the Python, Flutter and React Native packages run the same actions. In our test, the Python package produced a byte-for-byte identical WAV file from the same recording.',
  },
];

const jsonLd = useCaseJsonLd(meta, site, faq, ['Audio processing', 'Node.js', 'Express', 'WAV', 'Noise reduction']);

const setup = `
mkdir voice-cleaner && cd voice-cleaner
npm init -y
npm pkg set type=module
npm install morflow`;

const pipeline = `
import audio_basics/latest

# A WAV file, read straight from disk or from an upload
accept Bytes $wav
# The sample rate of the finished file
accept IntArg $rate = 48000
# Mains hum: 50 Hz in Europe and most of Asia, 60 Hz in the Americas
accept FloatArg $hum = 50

$wav
  >> to_audio
  >> biquad_filter(type="highpass", freq=80)
  >> biquad_filter(type="notch", freq=$hum, q=5)
  >> noise_gate(threshold_db=-50)
  >> compressor(threshold_db=-24, ratio=3)
  >> normalize(mode="rms", target_db=-20)
  >> limiter(ceiling_db=-1)
  >> resample(to_rate=$rate)
  >> to_wav
  >> emit`;

const prep = `npx morflow prep pipelines/clean-voice.morf`;

const postinstall = `
{
  "scripts": {
    "postinstall": "morflow prep pipelines/clean-voice.morf"
  }
}`;

const cleanJs = `
import fs from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import morflow from 'morflow';

const pipeline = morflow.load('pipelines/clean-voice.morf');

const inputDir = process.argv[2] ?? 'recordings';
const outputDir = process.argv[3] ?? 'cleaned';
await fs.mkdir(outputDir, { recursive: true });

const queue = (await fs.readdir(inputDir)).filter((name) => name.toLowerCase().endsWith('.wav'));
const total = queue.length;
let done = 0;

async function cleanNext() {
  let name;
  while ((name = queue.shift())) {
    const wav = await fs.readFile(path.join(inputDir, name));
    const cleaned = await pipeline.run(wav);
    await fs.writeFile(path.join(outputDir, name), cleaned.toBuffer());
    console.log(\`[\${++done}/\${total}] \${name}\`);
  }
}

// Clean as many files at once as the computer has CPU cores.
const workers = Array.from({ length: os.availableParallelism() }, cleanNext);
await Promise.all(workers);`;

const runClean = `
node clean.js
# [1/3] interview-02.wav
# [2/3] voice-note-03.wav
# [3/3] episode-01.wav

# Or choose the folders
node clean.js ~/Podcast/raw ~/Podcast/cleaned`;

const serverJs = `
import express from 'express';
import morflow from 'morflow';

const pipeline = morflow.load('pipelines/clean-voice.morf');
const app = express();

const wavBody = express.raw({ type: ['audio/wav', 'audio/x-wav', 'audio/wave'], limit: '500mb' });

app.post('/clean', wavBody, async (req, res) => {
  const wav = req.body;
  if (!Buffer.isBuffer(wav) || wav.toString('ascii', 0, 4) !== 'RIFF' || wav.toString('ascii', 8, 12) !== 'WAVE') {
    return res.status(415).json({ error: 'Send a WAV file with Content-Type: audio/wav' });
  }
  const rate = Number(req.query.rate ?? 48000);
  const hum = Number(req.query.hum ?? 50);
  if (![16000, 22050, 44100, 48000].includes(rate) || ![50, 60].includes(hum)) {
    return res.status(400).json({ error: 'rate must be 16000, 22050, 44100 or 48000, and hum 50 or 60' });
  }

  try {
    const cleaned = await pipeline.runArgs(wav, rate, hum);
    res.type('audio/wav').send(cleaned.toBuffer());
  } catch (err) {
    res.status(422).json({ error: err.message });
  }
});

app.get('/health', (req, res) => res.send('ok'));

app.listen(3000, () => console.log('Listening on http://localhost:3000'));`;

const curl = `
curl -X POST "http://localhost:3000/clean?rate=16000&hum=60" \\
  -H "Content-Type: audio/wav" \\
  --data-binary @interview.wav \\
  -o interview-clean.wav`;

const docs = (hash: string) => withBase(`/doc/#${hash}`);
---
<Base
  title={`${meta.seoTitle} | Morflow`}
  description={meta.summary}
  path={useCasePath(meta.slug)}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="uc-article">
    <nav aria-label="Breadcrumb">
      <ol class="uc-crumbs">
        <li><a href={withBase('/')}>Home</a></li>
        <li><a href={withBase('/usecases/')}>Use Cases</a></li>
        <li aria-current="page">Audio processing in Node.js</li>
      </ol>
    </nav>

    <h1 class="uc-title">{meta.title}</h1>
    <div class="uc-meta">
      <ul class="uc-tags" aria-label="Topics">{meta.tags.map((t) => <li class="uc-tag">{t}</li>)}</ul>
      <span>{meta.minutes} min read</span>
      <span>Updated <time datetime={meta.updated}>{longDate(meta.updated)}</time></span>
    </div>

    <p class="uc-lede">
      Voice recordings rarely come out the way you want. One interview is too quiet, another has a hum from a laptop charger, and every file is at a different volume and sample rate.
    </p>
    <p class="doc-p">
      In Node.js, fixing that usually means starting an ffmpeg or SoX process for every file, or writing filters by hand in JavaScript. This guide does it with a Morflow pipeline instead: a short text file that describes the clean-up, run by native code inside your Node.js process. We'll use it twice, in a script that cleans a whole folder at once and in an Express endpoint that cleans uploads.
    </p>

    <h2 class="uc-h2" id="what">What the pipeline does to each recording</h2>
    <ul class="uc-list-plain">
      <li><strong>Removes rumble and hum.</strong> A high-pass filter takes out the low rumble of traffic, air conditioning and desk bumps. A notch filter takes out the 50 or 60 Hz hum from mains power.</li>
      <li><strong>Quiets the gaps.</strong> A noise gate turns down the background hiss between words.</li>
      <li><strong>Evens out the voice.</strong> A compressor brings loud and quiet parts closer together, and normalization sets every file to the same level.</li>
      <li><strong>Prevents clipping.</strong> A limiter keeps the loudest peaks below −1 dB.</li>
      <li><strong>Converts the sample rate.</strong> Every file comes out at the rate you choose: 48 kHz for video, 44.1 kHz for music, 16 kHz for speech recognition.</li>
    </ul>

    <h2 class="uc-h2" id="setup"><span class="uc-step">Step 1</span>Create the project</h2>
    <p class="doc-p">
      You need Node.js 18 or newer. Create a folder and install the <code>morflow</code> package. The package includes the Morflow CLI, which we use in Step 3.
    </p>
    <CodeCard title="Create the Project" lang="shell" label="Shell" code={setup} />

    <h2 class="uc-h2" id="pipeline"><span class="uc-step">Step 2</span>Write the pipeline</h2>
    <p class="doc-p">Save this as <code>pipelines/clean-voice.morf</code>:</p>
    <CodeCard title="pipelines/clean-voice.morf" lang="morf" code={pipeline} />
    <p class="doc-p">Each line after <code>$wav</code> is one step, and the audio flows through them from top to bottom:</p>
    <ul class="uc-list-plain">
      <li><code>accept Bytes $wav</code> takes the WAV file exactly as it is on disk, so Node.js never has to decode it. <code>$rate</code> and <code>$hum</code> are settings with default values, which you can change each time you run the pipeline.</li>
      <li><code>to_audio</code> reads the WAV header and turns the samples into audio, whatever the bit depth or number of channels.</li>
      <li>The first <code>biquad_filter</code> removes everything below 80 Hz, which is lower than almost any speaking voice goes. The second removes a narrow band around the hum frequency.</li>
      <li><code>noise_gate</code> turns down any sound quieter than −50 dB, such as the hiss between words.</li>
      <li><code>compressor</code> softens the parts louder than −24 dB by a ratio of 3 to 1, so a laugh or a raised voice doesn't stick out.</li>
      <li><code>normalize</code> sets the average level (RMS) of every file to −20 dB, and <code>limiter</code> catches any peak above −1 dB.</li>
      <li><code>resample</code> converts to <code>$rate</code>, and <code>to_wav</code> writes a 16-bit WAV file.</li>
    </ul>

    <h2 class="uc-h2" id="prep"><span class="uc-step">Step 3</span>Download the audio actions</h2>
    <p class="doc-p">
      Each step in the pipeline is a compiled action from the <code>audio_basics</code> pack. Download them once with <code>prep</code>. It finds every action the pipeline uses and checks each download against its published checksum:
    </p>
    <CodeCard title="Prepare the Pipeline" lang="shell" label="Shell" code={prep} />
    <p class="doc-p">
      The actions are saved in <code>~/.morflow/actions</code>, and from then on everything runs offline. On a server or in CI, add <code>prep</code> to <code>package.json</code> as a <code>postinstall</code> script, so <code>npm install</code> downloads the actions too:
    </p>
    <CodeCard title="package.json" lang="text" label="JSON" code={postinstall} />
    <div class="doc-callout uc-callout">
      <strong>Running in Docker?</strong> Run <code>npm install</code> as the same user that runs the app, or set <code>MORFLOW_ACTIONS_PATH</code> to the same folder for both, so the app finds the actions that <code>prep</code> downloaded.
    </div>

    <h2 class="uc-h2" id="batch"><span class="uc-step">Step 4</span>Clean a whole folder at once</h2>
    <p class="doc-p">
      Put your recordings in a <code>recordings</code> folder and save this as <code>clean.js</code>:
    </p>
    <CodeCard title="clean.js" lang="js" code={cleanJs} />
    <p class="doc-p">
      The pipeline is loaded once and reused for every file. <code>pipeline.run(wav)</code> passes the file's bytes to <code>$wav</code> and uses the default 48 kHz and 50 Hz for the settings. It returns a Promise, and the actual work happens on Morflow's native threads, so several files can be processed at the same time.
    </p>
    <p class="doc-p">
      Starting all the files at once would read every one of them into memory first. Instead, the script starts one small worker per CPU core, and each worker takes the next file from the queue until none are left. That keeps all the cores busy and memory use steady, whether the folder has ten files or ten thousand.
    </p>
    <CodeCard title="Run It" lang="shell" label="Shell" code={runClean} />

    <h2 class="uc-h2" id="express"><span class="uc-step">Step 5</span>Clean uploads in an Express server</h2>
    <p class="doc-p">
      The same pipeline works in a web server. Install Express (<code>npm install express</code>) and save this as <code>server.js</code>:
    </p>
    <CodeCard title="server.js" lang="js" code={serverJs} />
    <ul class="uc-list-plain">
      <li><code>express.raw</code> gives you the upload as a <code>Buffer</code>, which goes straight into the pipeline.</li>
      <li>The <code>RIFF</code> and <code>WAVE</code> check turns away anything that isn't a WAV file. It only checks the header, so a damaged WAV file can still get through and come out as noise.</li>
      <li><code>runArgs(wav, rate, hum)</code> sets the pipeline's inputs in the order they're declared: the file, then <code>$rate</code>, then <code>$hum</code>.</li>
      <li>The work happens off the event loop, so the server keeps answering other requests, including <code>/health</code>, while a long file is processed.</li>
    </ul>
    <p class="doc-p">Start it with <code>node server.js</code> and send it a file. This one asks for 16 kHz output and removes 60 Hz hum:</p>
    <CodeCard title="Try It" lang="shell" label="Shell" code={curl} />

    <h2 class="uc-h2" id="speed">How fast is it?</h2>
    <p class="doc-p">
      We timed the scripts from this guide on a laptop with an AMD Ryzen AI 9 365 (10 cores, 20 threads), with Node.js 26 and Morflow 0.3.5:
    </p>
    <div class="doc-table-container">
      <table class="doc-table">
        <thead>
          <tr><th>Test</th><th>Result</th></tr>
        </thead>
        <tbody>
          <tr><td>One 30-minute stereo recording (44.1 kHz)</td><td>11 to 13 seconds, about 150 times faster than real time</td></tr>
          <tr><td>24 three-minute recordings, one at a time</td><td>9.6 seconds</td></tr>
          <tr><td>The same 24 recordings with <code>clean.js</code></td><td>2.9 seconds, including starting Node.js: 72 minutes of audio, about 1,500 times faster than real time</td></tr>
          <tr><td>Longest event loop pause while <code>run()</code> processed the 30-minute file</td><td>77 ms</td></tr>
          <tr><td>The same with <code>runSync()</code></td><td>11.2 seconds, the whole run</td></tr>
          <tr><td><code>/health</code> while the server cleaned the 30-minute file</td><td>Answered in 1 to 4 ms</td></tr>
        </tbody>
      </table>
    </div>
    <p class="doc-p">
      Processing several files at once is where most of the speed comes from: the batch finished more than three times faster than processing the files one by one. Your numbers will depend on your CPU, but the pattern is the same: use <code>run()</code>, keep several files going at once, and the cores stay busy while the event loop stays free.
    </p>

    <h2 class="uc-h2" id="faq">Questions people ask</h2>
    <div class="uc-faq">
      {faq.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>

    <h2 class="uc-h2" id="next">Where to go next</h2>
    <div class="uc-next">
      <a href={docs('exec-js')}>Morflow in Node.js</a>
      <a href={docs('syntax')}>The .morf syntax</a>
      <a href={docs('cli-prep')}>Preparing pipelines with prep</a>
      <a href={withBase('/usecases/')}>More use cases</a>
    </div>
  </article>
</Base>
