---
interface Props { phase: 'static' | 'runtime'; }
const { phase } = Astro.props;
const isStatic = phase === 'static';
const marker = `arrow-${phase}`;
const nodes = isStatic ? [
  {x:15,y:175,w:165,h:70,lines:['Declared input shape','or predicted output']},
  {x:225,y:175,w:155,h:70,lines:['shapecheck'],accent:true},
  {x:425,y:145,w:130,h:130,lines:['Result?'],diamond:true},
  {x:635,y:30,w:190,h:80,lines:['Mark Verified'],accent:true},
  {x:635,y:170,w:190,h:80,lines:['Mark Runtime check','Record unresolved','reasons']},
  {x:635,y:320,w:190,h:80,lines:['Static check fails','Report error'],error:true},
  {x:905,y:105,w:190,h:110,lines:['Use predicted output','to check next action']},
] : [
  {x:10,y:140,w:115,h:80,lines:['Actual input']},
  {x:165,y:140,w:125,h:80,lines:['shapecheck'],accent:true},
  {x:330,y:120,w:120,h:120,lines:['Result?'],diamond:true},
  {x:505,y:140,w:135,h:80,lines:['process','Payload +','prepared data'],accent:true},
  {x:705,y:140,w:135,h:80,lines:['Verify output','Type +','predicted shape']},
  {x:880,y:120,w:120,h:120,lines:['Matches?'],diamond:true},
  {x:1050,y:140,w:125,h:80,lines:['Next action']},
  {x:290,y:335,w:200,h:80,lines:['Return error','Process is not called'],error:true},
  {x:505,y:335,w:170,h:80,lines:['Processing error'],error:true},
  {x:850,y:335,w:200,h:80,lines:['Output contract error'],error:true},
];
const edges = isStatic ? [
  {d:'M180 210 H225'}, {d:'M380 210 H425'},
  {d:'M490 145 V70 H635',label:'Ready',x:565,y:58},
  {d:'M555 210 H635',label:'Deferred',x:594,y:198},
  {d:'M490 275 V360 H635',label:'Invalid',x:565,y:348},
  {d:'M825 70 H865 V140 H905'}, {d:'M825 210 H865 V180 H905'},
] : [
  {d:'M125 180 H165'}, {d:'M290 180 H330'},
  {d:'M450 180 H505',label:'Ready',x:477,y:165},
  {d:'M390 240 V335',label:'Deferred / Invalid',x:390,y:290},
  {d:'M640 180 H705',label:'Success',x:672,y:165},
  {d:'M572 220 V335',label:'Failure',x:601,y:280},
  {d:'M840 180 H880'},
  {d:'M1000 180 H1050',label:'Yes',x:1025,y:165},
  {d:'M940 240 V335',label:'No',x:963,y:290},
];
---
<figure class="action-diagram" aria-labelledby={`action-${phase}-title`}>
  <figcaption><h4 id={`action-${phase}-title`}>{isStatic ? 'Static checking — each action' : 'Runtime — each action call'}</h4><p>{isStatic ? 'Check declared shapes and available arguments without running process.' : 'Check actual input before processing, then verify the returned output.'}</p></figcaption>
  <div class="diagram-scroll" tabindex="0" role="region" aria-label={`${isStatic ? 'Static' : 'Runtime'} shapecheck flowchart. Scroll horizontally on smaller screens.`}>
    <svg viewBox={`0 0 ${isStatic ? 1120 : 1190} 440`} role="img" aria-labelledby={`flow-${phase}-title flow-${phase}-desc`}>
      <title id={`flow-${phase}-title`}>{isStatic ? 'Static shapecheck flowchart' : 'Runtime shapecheck flowchart'}</title>
      <desc id={`flow-${phase}-desc`}>{isStatic ? 'Declared input enters shapecheck. Ready marks the action Verified; Deferred marks Runtime check and records unresolved reasons. Both carry predicted output to the next action. Invalid reports an error and fails static checking.' : 'Actual input enters shapecheck. Ready calls process with payload and prepared data. Deferred or Invalid returns an error without calling process. Processing failure returns a processing error. Successful processing verifies output against the predicted type and shape. A match continues to the next action; a mismatch returns an output contract error.'}</desc>
      <defs><marker id={marker} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="arrowhead" /></marker></defs>
      {edges.map(edge => <g><path d={edge.d} class="connector" marker-end={`url(#${marker})`} />{edge.label && <text x={edge.x} y={edge.y} class="edge-label">{edge.label}</text>}</g>)}
      {nodes.map(node => <g class:list={['node',{accent:node.accent,error:node.error}]}>
        {node.diamond ? <polygon points={`${node.x+node.w/2},${node.y} ${node.x+node.w},${node.y+node.h/2} ${node.x+node.w/2},${node.y+node.h} ${node.x},${node.y+node.h/2}`} /> : <rect x={node.x} y={node.y} width={node.w} height={node.h} rx="7" />}
        <text x={node.x+node.w/2} y={node.y+node.h/2-(node.lines.length-1)*11+5}>{node.lines.map((line,i)=><tspan x={node.x+node.w/2} dy={i===0?0:22}>{line}</tspan>)}</text>
      </g>)}
    </svg>
  </div>
  <p class="note">{isStatic ? 'Repeat for every action. The report includes each result and the overall shape safety percentage.' : 'Repeat for every action execution, including every loop iteration.'}</p>
</figure>
<style>
.action-diagram { margin:0; padding:24px; border:1px solid var(--grey-200); border-radius:12px; background:color-mix(in srgb,var(--brand-500) 3%,var(--white)); color:var(--grey-900); }
h4 { margin:0 0 8px; font-size:22px; font-family:var(--font-display); }
p { margin:0; font-size:14px; line-height:1.6; color:var(--grey-800); }
.diagram-scroll { overflow-x:auto; margin:16px 0; }
.diagram-scroll:focus-visible { outline:2px solid var(--brand-500); outline-offset:3px; }
svg { display:block; width:100%; min-width:850px; font-family:var(--font-ui); }
.action-diagram :global(.node rect),.action-diagram :global(.node polygon) { fill:var(--white); stroke:var(--grey-600); stroke-width:1.5; }
.action-diagram :global(.node.accent rect) { fill:color-mix(in srgb,var(--brand-500) 10%,var(--white)); stroke:var(--brand-500); stroke-width:2; }
.action-diagram :global(.node.error rect) { stroke:var(--brand-500); stroke-dasharray:5 3; }
.action-diagram :global(text) { fill:var(--grey-900); text-anchor:middle; font-size:15px; font-weight:600; }
.action-diagram :global(.connector) { fill:none; stroke:var(--brand-500); stroke-width:2; stroke-linejoin:round; }
.action-diagram :global(.arrowhead) { fill:var(--brand-500); }
.action-diagram :global(.edge-label) { fill:var(--brand-500); font-size:13px; paint-order:stroke; stroke:var(--white); stroke-width:5px; stroke-linejoin:round; }
.note { padding-top:14px; border-top:1px solid var(--grey-200); }
@media(max-width:600px) { .action-diagram { padding:16px; } }
</style>
