---
import { withBase } from '../../lib/content';

// Results from examples/benchmark in the Morflow repo (median of sample means).
// Each bar shows throughput, so a longer bar is faster. Rerun a benchmark and
// replace its figures together with that tab's version pin.
interface Row {
  engine: 'morflow' | 'numpy';
  name: string;
  detail: string;
  throughput: number;
  ms: number;
}

interface Tab {
  id: string;
  label: string;
  description: string;
  caption: string;
  unit: string;
  timeUnit: string;
  rows: Row[];
  pin: string;
  url: string;
}

const repo = 'https://github.com/JiraPit/Morflow/tree/main/examples/benchmark';
const machine = 'AMD Ryzen AI 9 365 · Linux · Nov 2026';
const tabs: Tab[] = [
  {
    id: 'audio',
    label: 'Audio',
    description:
      'A 10-second stereo clip: decode the WAV, resample to 16 kHz, high-pass filter, normalize, then compute a spectrogram and re-encode the WAV.',
    caption: 'Audio processed per second',
    unit: 's of audio / sec',
    timeUnit: 'ms per 10 s clip',
    rows: [
      { engine: 'morflow', name: 'Morflow', detail: '4 threads', throughput: 369.2, ms: 27.2 },
      { engine: 'morflow', name: 'Morflow', detail: '1 thread', throughput: 191.9, ms: 51.7 },
      { engine: 'numpy', name: 'NumPy + SciPy', detail: '1 thread', throughput: 97.1, ms: 102.3 },
    ],
    pin: `Morflow 0.3.2 · NumPy 2.2.6 · SciPy 1.15.3 · ${machine}`,
    url: `${repo}/audio`,
  },
  {
    id: 'tensor',
    label: 'Tensor',
    description:
      'A 256 × 256 float32 matrix through 12 matrix inversions, each followed by a transpose, then a Cholesky decomposition.',
    caption: 'Pipeline runs per second',
    unit: 'runs / sec',
    timeUnit: 'ms per run',
    rows: [
      { engine: 'morflow', name: 'Morflow', detail: 'BLAS plugin', throughput: 92.0, ms: 10.9 },
      { engine: 'numpy', name: 'NumPy', detail: 'numpy.linalg', throughput: 25.1, ms: 39.4 },
      { engine: 'morflow', name: 'Morflow', detail: 'built-in actions', throughput: 2.8, ms: 354.8 },
    ],
    pin: `Morflow 0.3.2 · NumPy 2.2.6 · OpenBLAS, default threads · ${machine}`,
    url: `${repo}/simple_tensor`,
  },
];

const formatThroughput = (value: number) => (value < 10 ? value.toFixed(1) : Math.round(value).toString());
---

<section class="bench-section" id="benchmark">
  <header class="section-header">
    <h2 class="section-title-orange">Benchmark</h2>
  </header>

  <div class="bench-card" data-bench-tabs>
    <div class="bench-tabs" role="tablist" aria-label="Benchmark workload">
      <span class="bench-tab-indicator" aria-hidden="true"></span>
      {tabs.map((tab, index) => (
        <button
          type="button"
          class="bench-tab"
          role="tab"
          id={`bench-tab-${tab.id}`}
          aria-controls={`bench-panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))}
    </div>

    {tabs.map((tab, index) => {
      const max = Math.max(...tab.rows.map((r) => r.throughput));
      return (
        <figure
          class="bench-panel"
          role="tabpanel"
          id={`bench-panel-${tab.id}`}
          aria-labelledby={`bench-tab-${tab.id}`}
          hidden={index !== 0}
        >
          <p class="bench-workload">{tab.description}</p>
          <figcaption class="bench-caption">{tab.caption} <span>(higher is faster)</span></figcaption>
          <ol class="bench-rows">
            {tab.rows.map((row, rowIndex) => {
              return (
                <li class="bench-row" style={`--i: ${rowIndex}`}>
                  <div class="bench-label">
                    <img
                      class="bench-logo"
                      src={withBase(row.engine === 'morflow' ? '/favicon.svg' : '/assets/benchmark/numpy.svg')}
                      alt=""
                      width="22"
                      height="22"
                    />
                    <span class="bench-name">{row.name}</span>
                    <span class="bench-detail">{row.detail}</span>
                  </div>
                  <div class="bench-track">
                    <div
                      class:list={['bench-bar', `bench-bar--${row.engine}`]}
                      style={`--share: ${(row.throughput / max).toFixed(4)}`}
                      title={`${row.name}, ${row.detail}: ${row.ms} ${tab.timeUnit}`}
                    ></div>
                    <span class="bench-value">
                      <span class="bench-num" data-value={row.throughput}>{formatThroughput(row.throughput)}</span> {tab.unit}
                    </span>
                  </div>
                </li>
              );
            })}
          </ol>
          <p class="bench-pin">
            {tab.pin} ·{' '}
            <a href={tab.url} target="_blank" rel="noopener">How it's measured</a>
          </p>
        </figure>
      );
    })}
  </div>
</section>

<script>
  // Tabs follow the WAI-ARIA pattern: click or arrow keys select a tab and
  // show its panel. Bars grow and numbers count up when the chart scrolls into
  // view and again on each tab switch. Without JavaScript, or with reduced
  // motion, everything shows in its final state.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ROW_DELAY = 110;
  const GROW_MS = 900;

  const format = (value: number) => (value < 10 ? value.toFixed(1) : Math.round(value).toString());

  const countUp = (panel: HTMLElement) => {
    panel.querySelectorAll<HTMLElement>('.bench-num').forEach((num, index) => {
      const target = Number(num.dataset.value);
      const start = performance.now() + index * ROW_DELAY;
      const step = (now: number) => {
        const t = Math.min(Math.max((now - start) / GROW_MS, 0), 1);
        num.textContent = format(target * (1 - Math.pow(1 - t, 3)));
        if (t < 1) requestAnimationFrame(step);
      };
      num.textContent = format(0);
      requestAnimationFrame(step);
      // Frames pause in background tabs; never leave a number part-way.
      setTimeout(() => { num.textContent = format(target); }, GROW_MS + index * ROW_DELAY + 100);
    });
  };

  document.querySelectorAll<HTMLElement>('[data-bench-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const indicator = root.querySelector<HTMLElement>('.bench-tab-indicator');
    const panelOf = (tab: HTMLButtonElement) => document.getElementById(tab.getAttribute('aria-controls') ?? '');
    let inView = false;

    const placeIndicator = (tab: HTMLButtonElement) => {
      indicator?.style.setProperty('--x', `${tab.offsetLeft}px`);
      indicator?.style.setProperty('--w', `${tab.offsetWidth}px`);
    };

    const reveal = (panel: HTMLElement) => {
      if (reduced) return;
      panel.classList.remove('is-shown');
      void panel.offsetWidth; // restart the transitions
      panel.classList.add('is-shown');
      countUp(panel);
    };

    const select = (next: HTMLButtonElement) => {
      tabs.forEach((tab) => {
        const selected = tab === next;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = panelOf(tab);
        if (!panel) return;
        panel.hidden = !selected;
        if (!selected) panel.classList.remove('is-shown');
      });
      placeIndicator(next);
      const panel = panelOf(next);
      if (panel && inView) reveal(panel);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        const target = event.key === 'Home' ? tabs[0] : event.key === 'End' ? tabs[tabs.length - 1]
          : step ? tabs[(index + step + tabs.length) % tabs.length] : null;
        if (!target) return;
        event.preventDefault();
        select(target);
        target.focus();
      });
    });

    if (reduced) return;
    root.classList.add('is-animated');
    const current = () => tabs.find((tab) => tab.getAttribute('aria-selected') === 'true') ?? tabs[0];

    // Place the indicator without sliding in from the left on first paint,
    // and again once web fonts settle the tab widths.
    root.classList.add('is-placing');
    placeIndicator(current());
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('is-placing')));
    document.fonts?.ready.then(() => placeIndicator(current()));
    window.addEventListener('resize', () => placeIndicator(current()));

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      inView = true;
      observer.disconnect();
      const panel = panelOf(current());
      if (panel) reveal(panel);
    }, { threshold: 0.35 });
    observer.observe(root);
  });
</script>

<style>
  .bench-section {
    padding: 60px 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
  }

  .section-title-orange {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: var(--brand-500, #db5837);
  }


  .bench-card {
    margin: 0;
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bench-tabs {
    display: inline-flex;
    align-self: flex-start;
    gap: 4px;
    padding: 4px;
    background: var(--grey-100);
    border-radius: 999px;
  }

  .bench-tab {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 7px 18px;
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    color: var(--grey-800);
    cursor: pointer;
    transition: background-color 0.2s var(--e-tween-out), color 0.2s var(--e-tween-out);
  }

  .bench-tab:hover {
    color: var(--grey-900);
  }

  .bench-tab[aria-selected='true'] {
    background: var(--white);
    color: var(--grey-900);
    box-shadow: 0 1px 3px rgba(37, 31, 25, 0.12);
  }

  .bench-tab:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
  }

  .bench-panel {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* display:flex above would otherwise override the hidden attribute. */
  .bench-panel[hidden] {
    display: none;
  }

  /* ---- Motion: only once the script adds .is-animated, so the chart shows
     its final state without JavaScript or with reduced motion. ---------- */
  .bench-tabs {
    position: relative;
  }

  .bench-tab {
    position: relative;
    z-index: 1;
  }

  .bench-tab-indicator {
    display: none;
  }

  .is-animated .bench-tab-indicator {
    display: block;
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    background: var(--white);
    border-radius: 999px;
    box-shadow: 0 1px 3px rgba(37, 31, 25, 0.12);
    transition: transform var(--d-spring) var(--e-spring), width var(--d-spring) var(--e-spring);
  }

  .is-animated.is-placing .bench-tab-indicator {
    transition: none;
  }

  .is-animated .bench-tab[aria-selected='true'] {
    background: transparent;
    box-shadow: none;
  }

  .is-animated .bench-bar {
    transform: scaleX(0);
    transform-origin: left center;
  }

  .is-animated .is-shown .bench-bar {
    transform: scaleX(1);
    transition: transform var(--d-spring-slow) var(--e-spring-slow);
    transition-delay: calc(var(--i) * 110ms);
  }

  .is-animated .bench-value,
  .is-animated .bench-workload,
  .is-animated .bench-caption,
  .is-animated .bench-pin {
    opacity: 0;
  }

  .is-animated .bench-value {
    transform: translateX(-8px);
  }

  .is-animated .is-shown .bench-value {
    opacity: 1;
    transform: none;
    transition: opacity 0.4s var(--e-tween-out), transform 0.4s var(--e-tween-out);
    transition-delay: calc(var(--i) * 110ms + 150ms);
  }

  .is-animated .is-shown .bench-workload,
  .is-animated .is-shown .bench-caption,
  .is-animated .is-shown .bench-pin {
    opacity: 1;
    transition: opacity 0.3s var(--e-tween-out);
  }

  .is-animated .is-shown .bench-pin {
    transition-delay: 0.45s;
  }

  .bench-workload {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.6;
    color: var(--grey-800);
    max-width: 820px;
  }

  .bench-caption {
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    color: var(--grey-900);
  }

  .bench-caption span {
    color: var(--grey-600);
    font-weight: 400;
  }

  .bench-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .bench-row {
    display: grid;
    grid-template-columns: 260px 1fr;
    align-items: center;
    gap: 16px;
  }

  .bench-label {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .bench-logo {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 6px;
  }

  .bench-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--grey-900);
    white-space: nowrap;
  }

  .bench-detail {
    font-family: var(--font-ui);
    font-size: 13.5px;
    color: var(--grey-600);
    white-space: nowrap;
  }

  .bench-track {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .bench-bar {
    height: 22px;
    min-width: 4px;
    flex-shrink: 0;
    /* Square at the baseline, rounded at the data end. */
    border-radius: 0 4px 4px 0;
    /* Every row scales against the same width, leaving room for the value. */
    width: calc((100% - 190px) * var(--share));
  }

  .bench-bar--morflow {
    background: var(--brand-500);
  }

  .bench-bar--numpy {
    background: var(--grey-400);
  }

  .bench-value {
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    color: var(--grey-900);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }


  .bench-pin {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--grey-200);
    font-family: var(--font-ui);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--grey-600);
  }

  .bench-pin a {
    color: var(--grey-800);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .bench-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .bench-bar {
      width: calc((100% - 150px) * var(--share));
    }

    .bench-value {
      font-size: 14px;
    }
  }
</style>
