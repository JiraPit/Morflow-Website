---
import { withBase } from '../../lib/content';
import { languages } from '../../content/languages';

const featured = languages.filter((l) => l.featured);
---

<section class="languages-section" id="languages">
  <header class="section-header">
    <h2 class="section-title-orange">Supported Languages and Frameworks</h2>
    <p class="section-desc">
      Write your pipeline once in .morf and execute natively across these supported languages and frameworks.
    </p>
  </header>

  <div class="languages-grid">
    {featured.map((lang) => (
      <article class="lang-card">
        <div class="lang-card__header">
          <img class="lang-card__logo" src={withBase(`/assets/languages/${lang.image}`)} alt={lang.name} width="36" height="36" loading="lazy" />
          <h3 class="lang-card__name">{lang.name}</h3>
        </div>
        <code class="lang-card__cmd">{lang.install}</code>
      </article>
    ))}
  </div>

  <a class="languages-more" href={withBase('/languages/')}>See the full list <span aria-hidden="true">→</span></a>
</section>

<style>
  .languages-section {
    padding: 44px 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
  }

  .section-title-orange {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: var(--brand-500, #db5837);
  }

  .section-desc {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 18px;
    line-height: 1.65;
    color: var(--grey-800);
    max-width: 920px;
    text-align: left;
  }

  .section-desc code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    background: var(--grey-100);
    padding: 2px 6px;
    border-radius: 4px;
    color: #b94b00;
  }

  /* Three columns; a shorter last row is centered. */
  .languages-grid {
    --cols: 3;
    --gap: 20px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    width: 100%;
  }

  .languages-grid > .lang-card {
    flex: 0 0 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    box-sizing: border-box;
    min-width: 0;
  }

  @media (max-width: 760px) {
    .languages-grid {
      --cols: 2;
    }
  }

  @media (max-width: 560px) {
    .languages-grid {
      --cols: 1;
    }
  }

  .languages-more {
    align-self: center;
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 600;
    color: var(--brand-500);
    text-decoration: none;
  }

  .languages-more:hover,
  .languages-more:focus-visible {
    text-decoration: underline;
  }

  .lang-card {
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    transition: transform var(--d-spring) var(--e-spring), box-shadow var(--d-spring) var(--e-spring);
  }

  .lang-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(37, 31, 25, 0.08);
  }

  .lang-card__header {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .lang-card__logo {
    display: block;
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .lang-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--grey-900);
  }

  .lang-card__cmd {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 13px;
    background: var(--background);
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--grey-900);
    border: 1px solid var(--grey-200);
    word-break: normal;
    overflow-wrap: anywhere;
  }
</style>
