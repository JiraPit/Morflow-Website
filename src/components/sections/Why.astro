---
import { group, type Benefit } from '../../lib/content';
const benefits = await group<Benefit>('benefits');
const row1 = benefits.slice(0, 3);
const row2 = benefits.slice(3, 6);
---
<section class="why" id="why">
  <header class="section-header">
    <h2 class="section-title-orange">Why Morflow?</h2>
  </header>

  <div class="why-rows">
    <div class="why-cards" role="list">
      {row1.map((b) => (
        <article class={`wcard${b.active ? ' is-active' : ''}`} data-index={b.num} tabindex="0" role="listitem">
          <div class="wcard__closed" aria-hidden="true">
            <p class="wcard__number">{b.num}.</p>
            <div class="wcard__closed-body">
              <p class="wcard__title-closed">{b.title}</p>
            </div>
          </div>
          <div class="wcard__open">
            <div class="wcard__img"><img src={b.image} alt="" loading="lazy" /></div>
            <div class="wcard__content">
              <h3 class="wcard__title">{b.title}</h3>
              <p class="wcard__desc">{b.desc}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="why-cards" role="list">
      {row2.map((b) => (
        <article class={`wcard${b.active ? ' is-active' : ''}`} data-index={b.num} tabindex="0" role="listitem">
          <div class="wcard__closed" aria-hidden="true">
            <p class="wcard__number">{b.num}.</p>
            <div class="wcard__closed-body">
              <p class="wcard__title-closed">{b.title}</p>
            </div>
          </div>
          <div class="wcard__open">
            <div class="wcard__img"><img src={b.image} alt="" loading="lazy" /></div>
            <div class="wcard__content">
              <h3 class="wcard__title">{b.title}</h3>
              <p class="wcard__desc">{b.desc}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .why {
    padding: 60px 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .section-title-orange {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: var(--brand-500, #db5837);
  }
</style>
