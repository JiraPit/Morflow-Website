---
import { group, withBase, type Feature } from '../../lib/content';
const features = await group<Feature>('features');
---
<section class="delegation" id="highlights">
  <header class="section-header">
    <h2 class="section-title-orange">Highlights</h2>
    <p class="section-desc">
      Express complex audio DSP, computer vision, and tensor operations as clean dataflow graphs. Morflow auto-parallelizes independent branches with native execution across runtimes.
    </p>
  </header>

  <div class="delegation__inner">
    <ol class="features" role="tablist" aria-label="Highlights features">
      {features.map((f) => (
        <li class="feature" style={`--i:${f.step}`}>
          <button
            class="feature__btn"
            type="button"
            role="tab"
            id={`feature-${f.step}`}
            data-step={f.step}
            aria-selected={f.step === 0 ? 'true' : 'false'}
            aria-controls={`mock-${f.step}`}
            tabindex={f.step === 0 ? 0 : -1}
          >
            <img class="feature__chevron" src={withBase('/assets/arrows.svg')} alt="" aria-hidden="true" />
            <span class="feature__head">
              <h4 class="feature__label">{f.label}</h4>
              <span class="feature__desc">{f.desc}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    <div class="stage">
      <!-- 0: Declarative .morf Pipelines -->
      <div
        class="mock is-active"
        id="mock-0"
        role="tabpanel"
        aria-labelledby="feature-0"
        data-step="0"
      >
        <div class="code-window">
          <div class="code-window__header">
            <div class="window-controls">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="window-tab">
              <svg class="file-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              <span class="window-title">pipeline.morf</span>
            </div>
            <span class="window-badge">.morf</span>
          </div>
          <div class="code-window__body">
            <pre class="tok-code"><code><span class="tok-comment"># Declarative image transformation flow</span>
<span class="tok-keyword">import</span> image_essentials/latest <span class="tok-keyword">as</span> img

<span class="tok-keyword">input</span> <span class="tok-var">$img_in</span>: <span class="tok-type">Image</span>

<span class="tok-keyword">flow</span> <span class="tok-fn">main</span> &#123;
  <span class="tok-var">$img_in</span>
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">img.resize</span>(<span class="tok-param">width</span>: <span class="tok-num">1920</span>, <span class="tok-param">height</span>: <span class="tok-num">1080</span>)
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">img.color_adjust</span>(<span class="tok-param">saturation</span>: <span class="tok-num">1.2</span>, <span class="tok-param">brightness</span>: <span class="tok-num">0.95</span>)
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">img.sharpen</span>(<span class="tok-param">strength</span>: <span class="tok-num">0.5</span>)
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span>()
&#125;</code></pre>
          </div>
        </div>
      </div>

      <!-- 1: Multi-Language (Python, JS, Rust - 3 blocks of code) -->
      <div
        class="mock"
        id="mock-1"
        role="tabpanel"
        aria-labelledby="feature-1"
        data-step="1"
        hidden
      >
        <div class="code-multi-stack">
          <!-- Python -->
          <div class="code-window mini">
            <div class="code-window__header">
              <div class="window-controls">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <div class="window-tab">
                <span class="lang-dot dot-py"></span>
                <span class="window-title">Python</span>
              </div>
              <span class="window-badge badge-py">python</span>
            </div>
            <div class="code-window__body">
              <pre class="tok-code"><code><span class="tok-keyword">import</span> morflow

pipeline = morflow.<span class="tok-fn">load</span>(<span class="tok-str">"pipeline.morf"</span>)
result = pipeline.<span class="tok-fn">run</span>(input_image)</code></pre>
            </div>
          </div>

          <!-- JavaScript / Node.js -->
          <div class="code-window mini">
            <div class="code-window__header">
              <div class="window-controls">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <div class="window-tab">
                <span class="lang-dot dot-js"></span>
                <span class="window-title">JavaScript / Node.js</span>
              </div>
              <span class="window-badge badge-js">node.js</span>
            </div>
            <div class="code-window__body">
              <pre class="tok-code"><code><span class="tok-keyword">import</span> morflow <span class="tok-keyword">from</span> <span class="tok-str">'morflow'</span>;

<span class="tok-keyword">const</span> pipeline = morflow.<span class="tok-fn">load</span>(<span class="tok-str">'pipeline.morf'</span>);
<span class="tok-keyword">const</span> result = <span class="tok-keyword">await</span> pipeline.<span class="tok-fn">run</span>(inputImage);</code></pre>
            </div>
          </div>

          <!-- Rust -->
          <div class="code-window mini">
            <div class="code-window__header">
              <div class="window-controls">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <div class="window-tab">
                <span class="lang-dot dot-rs"></span>
                <span class="window-title">Rust</span>
              </div>
              <span class="window-badge badge-rs">rust</span>
            </div>
            <div class="code-window__body">
              <pre class="tok-code"><code><span class="tok-keyword">use</span> morflow::Morflow;

<span class="tok-keyword">let mut</span> pipeline = Morflow::<span class="tok-fn">load</span>(<span class="tok-str">"pipeline.morf"</span>)?;
<span class="tok-keyword">let</span> result = pipeline.<span class="tok-fn">run</span>(input_image)?;</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- 2: Auto-Parallel Scheduling -->
      <div
        class="mock"
        id="mock-2"
        role="tabpanel"
        aria-labelledby="feature-2"
        data-step="2"
        hidden
      >
        <div class="code-window">
          <div class="code-window__header">
            <div class="window-controls">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="window-tab">
              <svg class="file-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              <span class="window-title">parallel_audio.morf</span>
            </div>
            <span class="window-badge">.morf</span>
          </div>
          <div class="code-window__body">
            <pre class="tok-code"><code><span class="tok-keyword">import</span> audio_essentials/latest <span class="tok-keyword">as</span> audio

<span class="tok-keyword">input</span> <span class="tok-var">$input_audio</span>: <span class="tok-type">Audio</span>

<span class="tok-keyword">flow</span> <span class="tok-fn">main</span> &#123;
  <span class="tok-var">$input_audio</span>
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">audio.to_audio</span>(<span class="tok-param">sample_rate</span>: <span class="tok-num">44100</span>)
    <span class="tok-comment"># Concurrently unrolled across CPU worker threads</span>
    <span class="tok-op">&gt;&gt;</span> <span class="tok-keyword">each</span> (<span class="tok-var">$channel</span>) &#123;
      <span class="tok-var">$channel</span>
        <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">audio.biquad_filter</span>(<span class="tok-param">filter_type</span>: <span class="tok-str">"highpass"</span>, <span class="tok-param">frequency</span>: <span class="tok-num">80.0</span>)
        <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">audio.compressor</span>(<span class="tok-param">threshold_db</span>: <span class="tok-num">-12.0</span>, <span class="tok-param">ratio</span>: <span class="tok-num">3.0</span>)
    &#125;
    <span class="tok-comment"># Receives stacked multi-channel stream</span>
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">audio.stereo_widen</span>(<span class="tok-param">width</span>: <span class="tok-num">1.2</span>)
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span>()
&#125;</code></pre>
          </div>
        </div>
      </div>

      <!-- 3: Large Library of Actions -->
      <div
        class="mock"
        id="mock-3"
        role="tabpanel"
        aria-labelledby="feature-3"
        data-step="3"
        hidden
      >
        <div class="code-window">
          <div class="code-window__header">
            <div class="window-controls">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="window-tab">
              <svg class="file-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              <span class="window-title">action_library.morf</span>
            </div>
            <span class="window-badge">.morf</span>
          </div>
          <div class="code-window__body">
            <pre class="tok-code"><code><span class="tok-comment"># Import pre-built actions across vision, DSP &amp; AI</span>
<span class="tok-keyword">import</span> image_essentials/latest <span class="tok-keyword">as</span> img
<span class="tok-keyword">import</span> audio_essentials/latest <span class="tok-keyword">as</span> audio
<span class="tok-keyword">import</span> vision_models/latest <span class="tok-keyword">as</span> cv
<span class="tok-keyword">import</span> tensor_math/latest <span class="tok-keyword">as</span> math

<span class="tok-keyword">flow</span> <span class="tok-fn">main</span> &#123;
  <span class="tok-var">$frame</span>
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">cv.detect_objects</span>(<span class="tok-param">model</span>: <span class="tok-str">"yolov8n"</span>, <span class="tok-param">confidence</span>: <span class="tok-num">0.85</span>)
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">img.draw_overlays</span>(<span class="tok-param">palette</span>: <span class="tok-str">"neon"</span>)
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">img.color_adjust</span>(<span class="tok-param">contrast</span>: <span class="tok-num">1.1</span>)
    <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span>()
&#125;</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    margin-bottom: 8px;
  }

  .section-title-orange {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: var(--brand-500, #db5837);
  }

  .section-desc {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 18px;
    line-height: 1.65;
    color: var(--grey-800);
    max-width: 820px;
    text-align: left;
  }

  /* Code Window Container */
  .code-window {
    background: #181512;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 20px 40px -12px rgba(26, 23, 20, 0.28),
      0 2px 8px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .code-window__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 18px;
    background: #211e1a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .window-controls .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red { background: #ff5f56; box-shadow: 0 0 4px rgba(255, 95, 86, 0.4); }
  .dot-yellow { background: #ffbd2e; box-shadow: 0 0 4px rgba(255, 189, 46, 0.4); }
  .dot-green { background: #27c93f; box-shadow: 0 0 4px rgba(39, 201, 63, 0.4); }

  .window-tab {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #cbd5e1;
  }

  .file-icon {
    color: #94a3b8;
    display: block;
  }

  .window-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: #e2e8f0;
    letter-spacing: -0.01em;
  }

  .window-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ff8a65;
    background: rgba(255, 138, 101, 0.12);
    border: 1px solid rgba(255, 138, 101, 0.3);
    padding: 3px 8px;
    border-radius: 5px;
  }

  .badge-py {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.3);
  }

  .badge-js {
    color: #facc15;
    background: rgba(250, 204, 21, 0.12);
    border-color: rgba(250, 204, 21, 0.3);
  }

  .badge-rs {
    color: #fb923c;
    background: rgba(251, 146, 60, 0.12);
    border-color: rgba(251, 146, 60, 0.3);
  }

  .lang-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-py { background: #38bdf8; }
  .dot-js { background: #facc15; }
  .dot-rs { background: #fb923c; }

  .code-window__body {
    padding: 20px 24px;
    overflow-x: auto;
    background: #181512;
  }

  .tok-code {
    margin: 0;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 14.5px;
    line-height: 1.7;
    color: #f8fafc;
    white-space: pre;
  }

  .tok-code code {
    color: #f8fafc;
    font-family: inherit;
    font-size: inherit;
    background: none;
    padding: 0;
    border: 0;
  }

  /* Multi-Stack (Python, JS, Rust) */
  .code-multi-stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .code-window.mini {
    border-radius: 11px;
    box-shadow:
      0 8px 20px -6px rgba(26, 23, 20, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.05);
  }

  .code-window.mini .code-window__header {
    padding: 7px 14px;
  }

  .code-window.mini .window-title {
    font-size: 12px;
  }

  .code-window.mini .window-badge {
    font-size: 10px;
    padding: 2px 6px;
  }

  .code-window.mini .code-window__body {
    padding: 12px 18px;
  }

  .code-window.mini .tok-code {
    font-size: 13.5px;
    line-height: 1.55;
  }

  /* High-Contrast Vivid Syntax Highlighting Tokens */
  .tok-keyword { color: #ff7a59; font-weight: 600; }
  .tok-fn { color: #38bdf8; font-weight: 500; }
  .tok-var { color: #fde047; font-weight: 500; }
  .tok-param { color: #93c5fd; }
  .tok-str { color: #4ade80; }
  .tok-num { color: #c084fc; font-weight: 500; }
  .tok-type { color: #fb923c; font-weight: 600; }
  .tok-op { color: #f43f5e; font-weight: 600; }
  .tok-comment { color: #94a3b8; font-style: italic; }
</style>
