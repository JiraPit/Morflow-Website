---
import { group, withBase, type Feature } from '../../lib/content';
const features = await group<Feature>('features');
---
<section class="delegation" id="highlights">
  <header class="section-header">
    <h2 class="section-title-orange">Highlights</h2>
    <p class="section-desc">
      Express complex audio DSP, computer vision, and tensor operations as clean dataflow graphs. Morflow auto-parallelizes independent branches with native execution across runtimes.
    </p>
  </header>

  <div class="delegation__inner">
    <ol class="features" role="tablist" aria-label="Highlights features">
      {features.map((f) => (
        <li class="feature" style={`--i:${f.step}`}>
          <button
            class="feature__btn"
            type="button"
            role="tab"
            id={`feature-${f.step}`}
            data-step={f.step}
            aria-selected={f.step === 0 ? 'true' : 'false'}
            aria-controls={`mock-${f.step}`}
            tabindex={f.step === 0 ? 0 : -1}
          >
            <img class="feature__chevron" src={withBase('/assets/arrows.svg')} alt="" aria-hidden="true" />
            <span class="feature__head">
              <h4 class="feature__label">{f.label}</h4>
              <span class="feature__desc">{f.desc}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    <div class="stage">
      <!-- 0: Declarative .morf Pipelines -->
      <div
        class="mock is-active"
        id="mock-0"
        role="tabpanel"
        aria-labelledby="feature-0"
        data-step="0"
      >
        <div class="code-window">
          <div class="code-window__header">
            <div class="window-controls">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="window-title">pipeline.morf</span>
            <span class="window-badge">.morf</span>
          </div>
          <div class="code-window__body">
            <pre class="tok-code"><code><span class="tok-comment"># Declarative image processing pipeline</span>
<span class="tok-keyword">import</span> image_essentials/latest <span class="tok-keyword">as</span> img

<span class="tok-keyword">input</span> <span class="tok-var">$img_in</span>: Image

<span class="tok-keyword">flow</span> <span class="tok-fn">main</span> &#123;
  <span class="tok-var">$img_in</span>
    &gt;&gt; <span class="tok-fn">img.resize</span>(width: <span class="tok-num">1920</span>, height: <span class="tok-num">1080</span>)
    &gt;&gt; <span class="tok-fn">img.color_adjust</span>(saturation: <span class="tok-num">1.2</span>, brightness: <span class="tok-num">0.95</span>)
    &gt;&gt; <span class="tok-fn">img.sharpen</span>(strength: <span class="tok-num">0.5</span>)
    &gt;&gt; <span class="tok-fn">emit</span>()
&#125;</code></pre>
          </div>
        </div>
      </div>

      <!-- 1: Multi-Language (Python, JS, Rust - 3 blocks of code) -->
      <div
        class="mock"
        id="mock-1"
        role="tabpanel"
        aria-labelledby="feature-1"
        data-step="1"
        hidden
      >
        <div class="code-multi-stack">
          <!-- Python -->
          <div class="code-window mini">
            <div class="code-window__header">
              <div class="window-controls">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <span class="window-title">Python</span>
              <span class="window-badge">python</span>
            </div>
            <div class="code-window__body">
              <pre class="tok-code"><code><span class="tok-keyword">import</span> morflow

pipeline = morflow.<span class="tok-fn">load</span>(<span class="tok-str">"pipeline.morf"</span>)
result = pipeline.<span class="tok-fn">run</span>(input_image)</code></pre>
            </div>
          </div>

          <!-- JavaScript / Node.js -->
          <div class="code-window mini">
            <div class="code-window__header">
              <div class="window-controls">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <span class="window-title">JavaScript / Node.js</span>
              <span class="window-badge">javascript</span>
            </div>
            <div class="code-window__body">
              <pre class="tok-code"><code><span class="tok-keyword">import</span> morflow <span class="tok-keyword">from</span> <span class="tok-str">'morflow'</span>;

<span class="tok-keyword">const</span> pipeline = morflow.<span class="tok-fn">load</span>(<span class="tok-str">'pipeline.morf'</span>);
<span class="tok-keyword">const</span> result = <span class="tok-keyword">await</span> pipeline.<span class="tok-fn">run</span>(inputImage);</code></pre>
            </div>
          </div>

          <!-- Rust -->
          <div class="code-window mini">
            <div class="code-window__header">
              <div class="window-controls">
                <span class="dot dot-red"></span>
                <span class="dot dot-yellow"></span>
                <span class="dot dot-green"></span>
              </div>
              <span class="window-title">Rust</span>
              <span class="window-badge">rust</span>
            </div>
            <div class="code-window__body">
              <pre class="tok-code"><code><span class="tok-keyword">use</span> morflow::Morflow;

<span class="tok-keyword">let mut</span> pipeline = Morflow::<span class="tok-fn">load</span>(<span class="tok-str">"pipeline.morf"</span>)?;
<span class="tok-keyword">let</span> result = pipeline.<span class="tok-fn">run</span>(input_image)?;</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- 2: Auto-Parallel Scheduling -->
      <div
        class="mock"
        id="mock-2"
        role="tabpanel"
        aria-labelledby="feature-2"
        data-step="2"
        hidden
      >
        <div class="code-window">
          <div class="code-window__header">
            <div class="window-controls">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="window-title">parallel_audio.morf</span>
            <span class="window-badge">.morf</span>
          </div>
          <div class="code-window__body">
            <pre class="tok-code"><code><span class="tok-keyword">import</span> audio_essentials/latest <span class="tok-keyword">as</span> audio

<span class="tok-keyword">input</span> <span class="tok-var">$input_audio</span>: Audio

<span class="tok-keyword">flow</span> <span class="tok-fn">main</span> &#123;
  <span class="tok-var">$input_audio</span>
    &gt;&gt; <span class="tok-fn">audio.to_audio</span>(sample_rate: <span class="tok-num">44100</span>)
    <span class="tok-comment"># Concurrently unrolled across CPU workers</span>
    &gt;&gt; <span class="tok-keyword">each</span> (<span class="tok-var">$channel</span>) &#123;
      <span class="tok-var">$channel</span>
        &gt;&gt; <span class="tok-fn">audio.biquad_filter</span>(filter_type: <span class="tok-str">"highpass"</span>, frequency: <span class="tok-num">80.0</span>)
        &gt;&gt; <span class="tok-fn">audio.compressor</span>(threshold_db: <span class="tok-num">-12.0</span>, ratio: <span class="tok-num">3.0</span>)
    &#125;
    <span class="tok-comment"># Receives stacked multi-channel stream</span>
    &gt;&gt; <span class="tok-fn">audio.stereo_widen</span>(width: <span class="tok-num">1.2</span>)
    &gt;&gt; <span class="tok-fn">emit</span>()
&#125;</code></pre>
          </div>
        </div>
      </div>

      <!-- 3: Large Library of Actions -->
      <div
        class="mock"
        id="mock-3"
        role="tabpanel"
        aria-labelledby="feature-3"
        data-step="3"
        hidden
      >
        <div class="code-window">
          <div class="code-window__header">
            <div class="window-controls">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="window-title">vision_dsp_pipeline.morf</span>
            <span class="window-badge">.morf</span>
          </div>
          <div class="code-window__body">
            <pre class="tok-code"><code><span class="tok-comment"># Import pre-built actions across media, vision, DSP &amp; AI</span>
<span class="tok-keyword">import</span> image_essentials/latest <span class="tok-keyword">as</span> img
<span class="tok-keyword">import</span> audio_essentials/latest <span class="tok-keyword">as</span> audio
<span class="tok-keyword">import</span> vision_models/latest <span class="tok-keyword">as</span> cv
<span class="tok-keyword">import</span> tensor_math/latest <span class="tok-keyword">as</span> math

<span class="tok-keyword">flow</span> <span class="tok-fn">main</span> &#123;
  <span class="tok-var">$frame</span>
    &gt;&gt; <span class="tok-fn">cv.detect_objects</span>(model: <span class="tok-str">"yolov8n"</span>, confidence: <span class="tok-num">0.85</span>)
    &gt;&gt; <span class="tok-fn">img.draw_overlays</span>(palette: <span class="tok-str">"neon"</span>)
    &gt;&gt; <span class="tok-fn">img.color_adjust</span>(contrast: <span class="tok-num">1.1</span>)
    &gt;&gt; <span class="tok-fn">emit</span>()
&#125;</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    margin-bottom: 8px;
  }

  .section-title-orange {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: var(--brand-500, #db5837);
  }

  .section-desc {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 18px;
    line-height: 1.65;
    color: var(--grey-800);
    max-width: 820px;
    text-align: left;
  }

  /* Code Window Styling */
  .code-window {
    background: #181512;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .code-window__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.035);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .window-controls .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }

  .window-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    font-weight: 500;
    color: #a8a29e;
  }

  .window-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-500, #db5837);
    background: rgba(219, 88, 55, 0.12);
    border: 1px solid rgba(219, 88, 55, 0.25);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .code-window__body {
    padding: 18px 22px;
    overflow-x: auto;
  }

  .tok-code {
    margin: 0;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 14px;
    line-height: 1.65;
    color: #f3eee9;
    white-space: pre;
  }

  /* Multi-Stack (Python, JS, Rust) */
  .code-multi-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .code-window.mini .code-window__header {
    padding: 6px 14px;
  }

  .code-window.mini .code-window__body {
    padding: 10px 16px;
  }

  .code-window.mini .tok-code {
    font-size: 13px;
    line-height: 1.5;
  }

  /* Syntax Highlighting Tokens */
  .tok-keyword { color: #db5837; font-weight: 600; }
  .tok-fn { color: #5bc0be; font-weight: 500; }
  .tok-var { color: #e07a5f; }
  .tok-str { color: #81b29a; }
  .tok-num { color: #f2cc8f; }
  .tok-comment { color: #7f7972; font-style: italic; }
  .tok-type { color: #9d8189; }
  .tok-op { color: #d4a373; font-weight: 600; }
</style>
