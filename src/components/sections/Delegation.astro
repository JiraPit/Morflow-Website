---
import { group, withBase, type Feature } from '../../lib/content';
const features = await group<Feature>('features');
---
<section class="delegation" id="highlights">
  <header class="section-header">
    <h2 class="section-title-orange">Highlights</h2>
    <p class="section-desc">
      Express complex audio DSP, computer vision, and tensor operations as clean dataflow graphs. Morflow auto-parallelizes independent branches with zero memory copying.
    </p>
  </header>

  <div class="delegation__inner">
    <ol class="features" role="tablist" aria-label="Highlights features">
      {features.map((f) => (
        <li class="feature" style={`--i:${f.step}`}>
          <button
            class="feature__btn"
            type="button"
            role="tab"
            id={`feature-${f.step}`}
            data-step={f.step}
            aria-selected={f.step === 0 ? 'true' : 'false'}
            aria-controls={`mock-${f.step}`}
            tabindex={f.step === 0 ? 0 : -1}
          >
            <img class="feature__chevron" src={withBase('/assets/arrows.svg')} alt="" aria-hidden="true" />
            <span class="feature__head">
              <h4 class="feature__label">{f.label}</h4>
              <span class="feature__desc">{f.desc}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    <div class="stage">
      {features.map((f) => (
        <div
          class={`mock${f.step === 0 ? ' is-active' : ''}`}
          id={`mock-${f.step}`}
          role="tabpanel"
          aria-labelledby={`feature-${f.step}`}
          data-step={f.step}
          hidden={f.step !== 0}
        >
          <img class="mock__img" src={f.mock} srcset={f.srcset} alt="" />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    margin-bottom: 8px;
  }

  .section-title-orange {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: var(--brand-500, #db5837);
  }

  .section-desc {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 18px;
    line-height: 1.65;
    color: var(--grey-800);
    max-width: 820px;
    text-align: left;
  }
</style>
