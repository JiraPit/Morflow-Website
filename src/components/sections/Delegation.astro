---
import { group, withBase, type Feature } from '../../lib/content';
const features = await group<Feature>('features');
---
<section class="delegation" id="highlights">
  <header class="section-header">
    <h2 class="section-title-orange">Highlights</h2>
    <p class="section-desc">
      Express complex audio DSP, computer vision, and tensor operations as clean dataflow graphs. Morflow auto-parallelizes independent branches with native execution across runtimes.
    </p>
  </header>

  <div class="delegation__inner">
    <ol class="features" role="tablist" aria-label="Highlights features">
      {features.map((f) => (
        <li class="feature" style={`--i:${f.step}`}>
          <button
            class="feature__btn"
            type="button"
            role="tab"
            id={`feature-${f.step}`}
            data-step={f.step}
            aria-selected={f.step === 0 ? 'true' : 'false'}
            aria-controls={`mock-${f.step}`}
            tabindex={f.step === 0 ? 0 : -1}
          >
            <svg
              class="feature__chevron"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--brand-500, #db5837)"
              stroke-width="2.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            <span class="feature__head">
              <h4 class="feature__label">{f.label}</h4>
              <span class="feature__desc">{f.desc}</span>
            </span>
          </button>
        </li>
      ))}
    </ol>

    <div class="stage">
      <!-- 0: Declarative .morf Pipelines -->
      <div
        class="mock is-active"
        id="mock-0"
        role="tabpanel"
        aria-labelledby="feature-0"
        data-step="0"
      >
        <div class="code-card">
          <div class="code-card__header">
            <div class="window-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="code-card__title">image_pipeline.morf</span>
          </div>
          <pre class="code-card__pre"><code><span class="tok-comment"># Declarative image transformation flow</span>
<span class="tok-keyword">import</span> base/latest
<span class="tok-keyword">from</span> base/latest <span class="tok-keyword">import</span> <span class="tok-fn">to_tensor</span>
<span class="tok-keyword">from</span> image_essentials/latest <span class="tok-keyword">import</span> <span class="tok-fn">resize</span>, <span class="tok-fn">color_adjust</span>, <span class="tok-fn">to_image</span>

<span class="tok-keyword">accept</span> <span class="tok-type">Image</span> <span class="tok-var">$img_in</span>
<span class="tok-keyword">accept</span> <span class="tok-type">IntArg</span> <span class="tok-var">$target_width</span> = <span class="tok-num">512</span>
<span class="tok-keyword">accept</span> <span class="tok-type">IntArg</span> <span class="tok-var">$target_height</span> = <span class="tok-num">512</span>

<span class="tok-var">$img_in</span>
  <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_tensor</span>(<span class="tok-param">color</span>=<span class="tok-str">"rgb"</span>, <span class="tok-param">dtype</span>=<span class="tok-str">"f32"</span>, <span class="tok-param">normalize</span>=<span class="tok-keyword">true</span>)
  <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">resize</span>(<span class="tok-param">width</span>=<span class="tok-var">$target_width</span>, <span class="tok-param">height</span>=<span class="tok-var">$target_height</span>)
  <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">color_adjust</span>(<span class="tok-param">contrast</span>=<span class="tok-num">1.15</span>, <span class="tok-param">saturation</span>=<span class="tok-num">1.05</span>)
  <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_image</span>(<span class="tok-param">color</span>=<span class="tok-str">"rgba"</span>, <span class="tok-param">dtype</span>=<span class="tok-str">"u8"</span>)
  <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span></code></pre>
        </div>
      </div>

      <!-- 1: Run Identically Anyway (Multiple Platforms & Languages) -->
      <div
        class="mock"
        id="mock-1"
        role="tabpanel"
        aria-labelledby="feature-1"
        data-step="1"
        hidden
      >
        <div class="lang-stack">
          <!-- Python -->
          <div class="code-card mini">
            <div class="code-card__header">
              <div class="lang-title-group">
                <img class="lang-logo" src={withBase('/assets/languages/python.png')} alt="" width="18" height="18" />
                <span class="code-card__title">Python</span>
              </div>
            </div>
            <pre class="code-card__pre"><code><span class="tok-keyword">import</span> morflow

pipeline = morflow.<span class="tok-fn">load</span>(<span class="tok-str">"image_pipeline.morf"</span>)
result = pipeline.<span class="tok-fn">run</span>(input_image)</code></pre>
          </div>

          <!-- JavaScript / Node.js -->
          <div class="code-card mini">
            <div class="code-card__header">
              <div class="lang-title-group">
                <img class="lang-logo" src={withBase('/assets/languages/nodejs.png')} alt="" width="18" height="18" />
                <span class="code-card__title">JavaScript / Node.js</span>
              </div>
            </div>
            <pre class="code-card__pre"><code><span class="tok-keyword">import</span> morflow <span class="tok-keyword">from</span> <span class="tok-str">'morflow'</span>;

<span class="tok-keyword">const</span> pipeline = morflow.<span class="tok-fn">load</span>(<span class="tok-str">'image_pipeline.morf'</span>);
<span class="tok-keyword">const</span> result = <span class="tok-keyword">await</span> pipeline.<span class="tok-fn">run</span>(tensorInput);</code></pre>
          </div>

          <!-- Rust -->
          <div class="code-card mini">
            <div class="code-card__header">
              <div class="lang-title-group">
                <img class="lang-logo" src={withBase('/assets/languages/rust.png')} alt="" width="18" height="18" />
                <span class="code-card__title">Rust</span>
              </div>
            </div>
            <pre class="code-card__pre"><code><span class="tok-keyword">use</span> morflow::Morflow;

<span class="tok-keyword">let mut</span> pipeline = Morflow::<span class="tok-fn">load</span>(<span class="tok-str">"image_pipeline.morf"</span>)?;
<span class="tok-keyword">let</span> result = pipeline.<span class="tok-fn">run</span>(payload)?;</code></pre>
          </div>
        </div>
      </div>

      <!-- 2: Auto-Parallel Scheduling -->
      <div
        class="mock"
        id="mock-2"
        role="tabpanel"
        aria-labelledby="feature-2"
        data-step="2"
        hidden
      >
        <div class="code-card">
          <div class="code-card__header">
            <div class="window-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="code-card__title">audio_split_pipeline.morf</span>
          </div>
          <pre class="code-card__pre"><code><span class="tok-keyword">import</span> audio_essentials/latest

<span class="tok-keyword">accept</span> <span class="tok-type">RawBytes</span> <span class="tok-var">$input_audio</span>

<span class="tok-comment"># FLOW 1 — ingest and decode</span>
<span class="tok-var">$input_audio</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_audio</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-var">$decoded</span>

<span class="tok-comment"># FLOW 2 &amp; FLOW 3 run concurrently ──────────────────────────</span>

<span class="tok-comment"># FLOW 2 — left channel, low-pass filter</span>
<span class="tok-var">$decoded</span>[0] <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">biquad_filter</span>(<span class="tok-param">type</span>=<span class="tok-str">"lowpass"</span>, <span class="tok-param">freq</span>=<span class="tok-num">1200.0</span>) <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_wav</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span>(<span class="tok-str">"left_filtered"</span>)

<span class="tok-comment"># FLOW 3 — right channel, high-pass filter</span>
<span class="tok-var">$decoded</span>[1] <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">biquad_filter</span>(<span class="tok-param">type</span>=<span class="tok-str">"highpass"</span>, <span class="tok-param">freq</span>=<span class="tok-num">800.0</span>) <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_wav</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span>(<span class="tok-str">"right_filtered"</span>)</code></pre>
        </div>
      </div>

      <!-- 3: Large Library of Actions -->
      <div
        class="mock"
        id="mock-3"
        role="tabpanel"
        aria-labelledby="feature-3"
        data-step="3"
        hidden
      >
        <div class="code-card">
          <div class="code-card__header">
            <div class="window-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="code-card__title">modular_pipeline.morf</span>
          </div>
          <pre class="code-card__pre"><code><span class="tok-comment"># Compose actions across image processing &amp; audio DSP</span>
<span class="tok-keyword">import</span> base/latest
<span class="tok-keyword">from</span> base/latest <span class="tok-keyword">import</span> <span class="tok-fn">to_tensor</span>
<span class="tok-keyword">from</span> image_essentials/latest <span class="tok-keyword">import</span> <span class="tok-fn">resize</span>, <span class="tok-fn">color_adjust</span>, <span class="tok-fn">to_image</span>
<span class="tok-keyword">from</span> audio_essentials/latest <span class="tok-keyword">import</span> <span class="tok-fn">to_audio</span>, <span class="tok-fn">biquad_filter</span>, <span class="tok-fn">to_wav</span>

<span class="tok-keyword">accept</span> <span class="tok-type">Image</span> <span class="tok-var">$img_in</span>
<span class="tok-keyword">accept</span> <span class="tok-type">RawBytes</span> <span class="tok-var">$audio_in</span>

<span class="tok-comment"># Vision and Audio streams running together</span>
<span class="tok-var">$img_in</span>   <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_tensor</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">resize</span>(<span class="tok-param">width</span>=<span class="tok-num">1280</span>, <span class="tok-param">height</span>=<span class="tok-num">720</span>) <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_image</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span>(<span class="tok-str">"image"</span>)
<span class="tok-var">$audio_in</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_audio</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">biquad_filter</span>(<span class="tok-param">type</span>=<span class="tok-str">"lowpass"</span>, <span class="tok-param">freq</span>=<span class="tok-num">1200.0</span>) <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">to_wav</span> <span class="tok-op">&gt;&gt;</span> <span class="tok-fn">emit</span>(<span class="tok-str">"audio"</span>)</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    margin-bottom: 8px;
  }

  .section-title-orange {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: var(--brand-500, #db5837);
  }

  .section-desc {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 18px;
    line-height: 1.65;
    color: var(--grey-800);
    max-width: 820px;
    text-align: left;
  }

  /* Code Card Container */
  .code-card {
    background: #191715;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 20px 40px -15px rgba(28, 24, 20, 0.28),
      0 0 0 1px rgba(255, 255, 255, 0.04);
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .code-card__header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 20px;
    background: #221f1b;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .window-dots .dot {
    width: 10.5px;
    height: 10.5px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }

  .code-card__title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: #ded9d2;
    letter-spacing: -0.01em;
  }

  .code-card__pre {
    margin: 0;
    padding: 24px 26px;
    overflow-x: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    line-height: 1.75;
    color: #f3eee8;
    background: #191715;
  }

  .code-card__pre code {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: none;
    padding: 0;
    border: 0;
  }

  /* Multi-Language Stack */
  .lang-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .code-card.mini {
    border-radius: 13px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .code-card.mini .code-card__header {
    padding: 9px 16px;
  }

  .lang-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-logo {
    display: block;
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .code-card.mini .code-card__title {
    font-size: 12.5px;
    font-weight: 600;
    color: #f1ede8;
  }

  .code-card.mini .code-card__pre {
    padding: 14px 18px;
    font-size: 13.5px;
    line-height: 1.6;
  }

  /* Syntax Highlighting Tokens */
  .tok-keyword { color: #ff7a59; font-weight: 600; }
  .tok-fn { color: #38bdf8; font-weight: 500; }
  .tok-var { color: #fde047; font-weight: 500; }
  .tok-param { color: #93c5fd; }
  .tok-str { color: #4ade80; }
  .tok-num { color: #c084fc; font-weight: 500; }
  .tok-op { color: #ff8a65; font-weight: 600; }
  .tok-type { color: #fb923c; font-weight: 600; }
  .tok-comment { color: #8e8880; font-style: italic; }
</style>
