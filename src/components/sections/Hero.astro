---
import Button from '../Button.astro';
import { withBase } from '../../lib/content';
---
<section class="hero" id="hero">
  <div class="hero__panel" id="hero-media">
    <img class="hero__img" src={withBase('/assets/Background.webp')} alt="" />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1 class="hero__headline">
        Morflow
      </h1>
      <p class="hero__lede">
        Morflow (pronounced <em>morph-flow</em>) is a modular, high-performance data processing engine built for AI/ML input/output processing and tensor transformations. Define processing pipelines for images, audio, tensors and more in declarative .morf files and reuse the same native actions across training and production serving with shared tensor storage and multi-threaded CPU execution.
      </p>
      <div style="display: flex; gap: 12px; align-items: center; justify-content: center;">
        <Button href={withBase('/doc')} label="Read Documentation" variant="primary" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero__headline {
    margin: 0;
    font-family: var(--font-logo);
    font-weight: 400;
    font-size: clamp(56px, 9vw, 88px);
    line-height: 1.05;
    letter-spacing: normal;
    color: var(--white, #ffffff);
    text-align: center;
    text-shadow: 0 2px 24px rgba(26, 23, 20, 0.25);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    pointer-events: none;
    z-index: 1;
  }

  .hero__lede {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 18px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.95);
    max-width: 780px;
    text-align: center;
    text-shadow:
      0 2px 4px rgba(0, 0, 0, 0.6),
      0 4px 16px rgba(0, 0, 0, 0.5),
      0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .hero__lede code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.92em;
    background: rgba(0, 0, 0, 0.4);
    padding: 2px 7px;
    border-radius: 4px;
    color: #ffd49c;
  }

  .hero__lede em {
    font-style: italic;
    color: rgba(255, 255, 255, 0.9);
  }
  @media (max-width: 810px) {
    .hero {
      height: auto;
      padding-top: 100px;
      padding-bottom: 20px;
    }
    .hero .hero__panel {
      position: relative;
      top: auto;
      left: -16px;
      width: calc(100% + 32px);
      max-width: none;
      height: auto;
      min-height: 586px;
      translate: none;
      border-radius: 0;
      will-change: auto;
    }
    .hero .hero__content {
      position: relative;
      min-height: 586px;
      box-sizing: border-box;
      padding: 36px 24px;
    }
    .hero .hero__img {
      transform: none;
      will-change: auto;
    }
    .hero__lede {
      font-size: 15px;
      line-height: 1.6;
    }
  }
</style>
